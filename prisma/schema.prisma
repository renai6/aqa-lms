// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssessmentType {
  QUIZ
  EXAM
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  ESSAY
}

enum QuestionMediaType {
  AUDIO
  IMAGE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PaymentType {
  PARTIAL
  FULL
}

enum PaymentStatus {
  PARTIALLY_PAID
  FULLY_PAID
}

enum StudentType {
  NEW
  OLD
}

enum CourseType {
  ON_SITE
  ONLINE
}

enum CourseDuration {
  SHORT
  LONG
}

enum PaymentFrequency {
  MONTHLY
  ONE_TIME
  YEARLY
}

enum Gender {
  MALE
  FEMALE
}

// Whether a Payment row is something a student submitted for review, or a
// record of money an admin logged (the checkout payment, or a catch-up row
// written when an existing enrollment starts being balance-tracked).
// The admin review queue shows only SUBMITTED rows.
enum PaymentSource {
  SUBMITTED
  CHECKOUT
}

//
// USERS & AUTH
//

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  firstName   String
  lastName    String
  displayName String?

  role               UserRole     @default(STUDENT)
  isActive           Boolean      @default(true)
  // Bumped whenever the password changes, which invalidates every previously
  // issued session JWT (they carry the version they were signed with).
  tokenVersion       Int          @default(0)
  gender             Gender?
  mustChangePassword Boolean      @default(false)
  address            String?
  contactNumber      String?
  facebookName       String?
  facebookLink       String?
  studentType        StudentType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments        Enrollment[]
  attempts           AssessmentAttempt[]
  grades             Grade[]
  certificates       Certificate[]
  subjectAssignments SubjectTeacher[]
  gradedAttempts     AssessmentAttempt[] @relation("GradedBy")
  purchases          Purchase[]
  reviewedPurchases  Purchase[]          @relation("ReviewedPurchases")
  reviewedPayments   Payment[]           @relation("ReviewedPayments")
  verificationTokens VerificationToken[]
  lessonCompletions  LessonCompletion[]
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

//
// COURSE STRUCTURE
//

model Course {
  id String @id @default(cuid())

  title       String
  description String?
  imageUrl    String?

  // Optional grouping: courses sharing a groupName collapse into one listing
  // (e.g. "Marhala 1/2/3" -> "Marhala"); level orders them within the group.
  groupName String?
  level     Int?

  // Short course code (e.g. "MM01") used to name batches: a batch opened in
  // September 2026 becomes "0926MM01". Courses without one keep numbered
  // batch labels.
  courseAlias String?

  courseType       CourseType        @default(ON_SITE)
  isPublished      Boolean           @default(false)
  passingGrade     Float             @default(75.0)
  tuitionFee       Decimal?
  meetLink         String?
  courseDuration   CourseDuration?
  paymentFrequency PaymentFrequency?
  miscFeeNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set when an admin archives the course. Archived courses are hidden from
  // every catalog, admin, and student surface but are never destroyed.
  archivedAt DateTime?

  subjects      Subject[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  purchaseItems PurchaseItem[]
  batches       Batch[]

  @@index([archivedAt])
}

model Subject {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  title       String
  description String?

  order Int
  units Int @default(1)

  // null = visible to everyone (mixed); MALE/FEMALE = restricted to that gender
  gender Gender?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons     Lesson[]
  assessments Assessment[]
  grades      Grade[]
  teachers    SubjectTeacher[]
  schedules   SubjectSchedule[]
  recordings  BatchRecording[]
}

model SubjectTeacher {
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  assignedAt DateTime @default(now())

  @@id([subjectId, userId])
}

model SubjectSchedule {
  id        String    @id @default(cuid())
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  day       DayOfWeek
  startTime String // "HH:MM" 24-hour, e.g. "19:00"
  endTime   String // "HH:MM" 24-hour, e.g. "21:00"

  @@index([subjectId])
}

model Batch {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  number   Int
  isActive Boolean @default(false)

  // Display label snapshotted when the batch opens, from the course alias and
  // the Manila month/year. Null for courses that had no alias at the time.
  name String?

  createdAt DateTime @default(now())

  enrollments   Enrollment[]
  lessonContent BatchLessonContent[]
  recordings    BatchRecording[]

  @@unique([courseId, number])
  @@index([courseId])
}

model BatchLessonContent {
  id       String @id @default(cuid())
  batchId  String
  batch    Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  materialUrl String?
  videoUrl    String?
  audioUrl    String?
  pptUrl      String?

  @@unique([batchId, lessonId])
}

// Class-session recordings for one subject as taught in one batch. Not tied to
// a lesson: a batch records the sessions it actually held, and Batch 34's
// Arabic recordings are a different list from Batch 35's.
model BatchRecording {
  id        String @id @default(cuid())
  batchId   String
  batch     Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  url   String
  // A class date carries no time, so @db.Date keeps it from drifting a day
  // across the Manila/UTC boundary.
  date  DateTime @db.Date
  title String?

  createdAt DateTime @default(now())

  @@index([batchId, subjectId])
}

model Lesson {
  id String @id @default(cuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  title       String
  description String?

  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions  LessonCompletion[]
  batchContent BatchLessonContent[]
}

//
// ENROLLMENT (ACTIVE STUDENTS)
//

model Enrollment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  // Set when an admin removes this student from the course. The row survives,
  // so payments, grades and certificates stay intact and auditable; the student
  // simply loses access. Cleared by a restore, or when a later purchase of the
  // same course is approved.
  removedAt     DateTime?
  removedReason String?

  progress Float @default(0)

  paymentStatus PaymentStatus @default(PARTIALLY_PAID)
  // The agreed total for this enrollment, snapshotted when an admin sets it.
  // Null means this enrollment's balance is not tracked, which is how every
  // enrollment created before this feature behaves.
  totalDue      Decimal?

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id])

  payments Payment[]

  @@unique([userId, courseId])
}

model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
}

model Purchase {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  status          EnrollmentStatus @default(PENDING)
  paymentType     PaymentType      @default(FULL)
  amountPaid      Decimal          @default(0)
  // Null means the student chose to pay later, so no proof exists to upload.
  paymentProofUrl String?
  adminRemarks    String?
  reviewedById    String?
  reviewedBy      User?            @relation("ReviewedPurchases", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           PurchaseItem[]
  enrollments     Enrollment[]
  payments        Payment[]

  @@index([userId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])

  @@unique([purchaseId, courseId])
  @@index([courseId])
}

// A student-submitted payment made after checkout, against one enrollment.
// `status` reuses EnrollmentStatus (PENDING/APPROVED/REJECTED) exactly as
// Purchase.status does. The resulting PARTIALLY_PAID/FULLY_PAID value is not
// stored here - it lives on Enrollment, and the admin picks it on approval.
model Payment {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id])
  amount       Decimal
  proofUrl     String
  status       EnrollmentStatus @default(PENDING)
  source       PaymentSource    @default(SUBMITTED)
  // Which purchase this money arrived with, when it arrived with one. Null for
  // student submissions and for enrollments created without a purchase.
  purchaseId   String?
  purchase     Purchase?        @relation(fields: [purchaseId], references: [id])
  adminRemarks String?
  reviewedById String?
  reviewedBy   User?            @relation("ReviewedPayments", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([enrollmentId])
  @@index([status])
  @@index([purchaseId])
  @@index([source, status])
}

//
// ASSESSMENTS
//

model Assessment {
  id String @id @default(cuid())

  title String
  type  AssessmentType

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  isPublished  Boolean @default(false)
  durationMins Int?
  passingScore Float?
  maxAttempts  Int?
  weight       Float   @default(1.0)

  // totalPoints is derived: SUM(Question.points)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  attempts  AssessmentAttempt[]
}

model Question {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  questionText String
  type         QuestionType

  points Int
  order  Int

  // Optional Google Drive audio/image shown with the question. Written together
  // or both left null; see lib/assessments/media.ts for the link parsing.
  mediaType QuestionMediaType?
  mediaUrl  String?

  options QuestionOption[]
  answers StudentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionOption {
  id String @id @default(cuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  label String
  value String

  isCorrect Boolean @default(false)
}

//
// STUDENT ATTEMPTS + ANSWERS
//

model AssessmentAttempt {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status AttemptStatus @default(IN_PROGRESS)

  score Float?

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  // Set when a teacher/admin grades essay answers
  gradedById String?
  gradedBy   User?     @relation("GradedBy", fields: [gradedById], references: [id])
  gradedAt   DateTime?

  answers StudentAnswer[]
}

model StudentAnswer {
  id String @id @default(cuid())

  attemptId String
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id])

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  answer String

  // Null for essays until manually graded
  isCorrect    Boolean?
  pointsEarned Float?

  // Teacher's written feedback on an essay answer (null until graded / for objective questions)
  feedback String?
}

//
// GRADES
//

model Grade {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  finalGrade Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, subjectId])
}

//
// CERTIFICATES
//

model Certificate {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  certificateNo String  @unique
  pdfUrl        String?

  issuedAt DateTime @default(now())

  @@unique([userId, courseId])
}

//
// ANNOUNCEMENTS
//

model Announcement {
  id String @id @default(cuid())

  title   String
  content String

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
